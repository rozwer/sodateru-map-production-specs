{
  "name": "sodateru-map-production-specs",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "check:codex-hooks": "node --test scripts/codex-mise-hook.test.mjs scripts/codex-subagent-model-hook.test.mjs",
    "dev": "node --experimental-transform-types --env-file-if-exists=.env tools/local/dev.ts",
    "start": "node --experimental-transform-types --env-file-if-exists=.env server/app/main.ts",
    "typecheck": "tsc --noEmit",
    "test:core": "node --experimental-transform-types --test server/core/*.test.ts",
    "contracts:build": "python docs/01_requirements/04_api/tools/build_contracts.py && node docs/01_requirements/04_api/tools/generate-client.mjs",
    "contracts:check": "node docs/01_requirements/04_api/tools/check_contracts.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "22.18.6",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "26.1.0",
    "shell-quote": "1.10.0",
    "smol-toml": "1.8.0",
    "typescript": "5.9.2",
    "vite": "7.1.5",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@hono/node-server": "1.19.1",
    "@openai/codex-sdk": "0.153.4",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "hono": "4.9.7",
    "mapbox-gl": "3.30.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0"
  }
}
