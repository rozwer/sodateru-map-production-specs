                  "const": "svg"
                },
                "element": {
                  "const": "svg"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "image"
                }
              }
            },
            "then": {
              "properties": {
                "renderer": {
                  "const": "native-image"
                },
                "element": {
                  "const": "img"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "video"
                }
              }
            },
            "then": {
              "properties": {
                "renderer": {
                  "const": "native-media"
                },
                "element": {
                  "const": "video"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "media-gallery"
                }
              }
            },
            "then": {
              "properties": {
                "renderer": {
                  "const": "native-media"
                },
                "element": {
                  "const": "div"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "illustration"
                }
              }
            },
            "then": {
              "properties": {
                "renderer": {
                  "const": "asset"
                },
                "element": {
                  "const": "img"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "pet-preview"
                }
              }
            },
            "then": {
              "properties": {
                "renderer": {
                  "const": "pet-atlas"
                },
                "element": {
                  "const": "canvas"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "backdrop"
                }
              }
            },
            "then": {
              "properties": {
                "renderer": {
                  "const": "dom"
                },
                "element": {
                  "const": "div"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "icon"
                }
              }
            },
            "then": {
              "properties": {
                "renderer": {
                  "const": "svg"
                },
                "element": {
                  "const": "svg"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "map-gesture"
                }
              }
            },
            "then": {
              "properties": {
                "renderer": {
                  "const": "mapbox-webgl"
                },
                "element": {
                  "const": "div"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "object-preview"
                }
              }
            },
            "then": {
              "properties": {
                "renderer": {
                  "const": "three-webgl"
                },
                "element": {
                  "const": "canvas"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "list"
                }
              }
            },
            "then": {
              "required": [
                "template",
                "itemsFrom",
                "itemKey",
                "variableLength"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "group"
                }
              }
            },
            "then": {
              "required": [
                "children"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "choice-group"
                }
              }
            },
            "then": {
              "required": [
                "selection",
                "optionElement",
                "options",
                "optionsFrom"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "text-input"
                }
              }
            },
            "then": {
              "required": [
                "label",
                "inputType"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "textarea"
                }
              }
            },
            "then": {
              "required": [
                "label"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "search-input"
                }
              }
            },
            "then": {
              "required": [
                "inputType",
                "events"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "image"
                }
              }
            },
            "then": {
              "required": [
                "assetPolicy",
                "altFrom"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "illustration"
                }
              }
            },
            "then": {
              "required": [
                "assetPolicy"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "chart"
                }
              }
            },
            "then": {
              "required": [
                "labelsFrom",
                "missingValues",
                "fixedShapeAllowed"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "map"
                }
              }
            },
            "then": {
              "required": [
                "attribution",
                "fallback"
              ]
            }
          }
        ]
      }
    }
  }
}
