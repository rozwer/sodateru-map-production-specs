      "itemKey": "media.id",
      "itemControls": [
        "editor--remove-photo",
        "editor--remove-video",
        "editor--play-video"
      ],
      "sampleTextPolicy": "purposeは役割または参照例。実表示はvalueFromから得る。"
    }
  },
  {
    "id": "editor--counter",
    "testId": "record-create--editor--counter",
    "kind": "content",
    "purpose": "本文の文字数8/300",
    "imageRegion": null,
    "implementation": {
      "type": "metric",
      "renderer": "dom",
      "element": "output",
      "valueFrom": "derived.characterCount(editor--body)",
      "referenceUse": "appearance-only",
      "screenRaster": false,
      "calculation": "関連する入力値のUnicode文字数を数え、入力上限と同じ規則で表示する。画像の例示値は参照しない。",
      "counterFor": "editor--body",
      "sampleTextPolicy": "purposeは役割または参照例。実表示はvalueFromから得る。"
    }
