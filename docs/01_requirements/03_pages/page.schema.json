{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "分割ページ仕様 index v2",
  "type": "object",
  "required": [
    "formatVersion",
    "id",
    "title",
    "status",
    "route",
    "files",
    "references",
    "viewports",
    "layout",
    "common",
    "sources",
    "apiGaps",
    "unresolved"
  ],
  "properties": {
    "formatVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "draft"
    },
    "route": {
      "type": [
        "string",
        "null"
      ]
    },
    "files": {
      "type": "object",
      "required": [
        "components",
        "states",
        "interactions",
        "api",
        "requirements",
        "acceptance"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "references": {
      "type": "array"
    },
    "viewports": {
      "type": "array",
      "minItems": 1
    },
    "layout": {
      "type": "object"
    },
    "common": {
      "type": "string"
    },
    "sources": {
      "type": "string"
    },
    "apiGaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
