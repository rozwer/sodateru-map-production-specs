          }
        },
        {
          "name": "If-Match",
          "in": "header",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "対象資源のversion。登録はimport、採用/取消はgenerationのversion。"
        }
      ],
      "responses": {
        "200": {
          "description": "成功",
          "content": {
            "application/json": {
