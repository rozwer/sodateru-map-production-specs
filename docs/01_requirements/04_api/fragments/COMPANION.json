      ],
      "responses": {
        "200": {
          "description": "成功",
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "default": {
          "description": "CORE共通エラー。形式不正・サイズ超過・未確認動作・未接続を区別する。",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorEnvelope"
