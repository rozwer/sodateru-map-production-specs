        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CompanionRegistrationInput"
            }
          }
        }
      },
      "description": "全requiredActions確認後に登録。selectCurrent=true時のみsettingsVersionを必須として同じtransactionで現在選択を更新。"
    },
