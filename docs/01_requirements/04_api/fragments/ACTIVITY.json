{
  "taskId": "ACTIVITY",
  "version": "1.0.0",
  "replaceSchemas": [
    "TrackPoint",
    "GrowthItem"
  ],
  "schemas": {
    "TrackPoint": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/components/schemas/Id",
          "description": "端末で発行した観測ID。再送時に維持"
        },
        "version": {
          "$ref": "#/components/schemas/Version",
          "description": "保存内容の版。編集時に1増やす。初期値1"
        },
        "createdAt": {
          "$ref": "#/components/schemas/Timestamp",
          "description": "観測時刻"
        },
        "updatedAt": {
          "$ref": "#/components/schemas/Timestamp",
          "description": "観測時刻"
        },
        "personId": {
          "$ref": "#/components/schemas/Id",
          "description": "端末で発行した観測ID。再送時に維持"
        },
        "segmentId": {
          "$ref": "#/components/schemas/Id",
          "description": "端末で発行した観測ID。再送時に維持"
        },
        "sourcePointId": {
          "$ref": "#/components/schemas/Id",
          "description": "端末で発行した観測ID。再送時に維持"
        },
        "observedAt": {
          "$ref": "#/components/schemas/Timestamp",
          "description": "観測時刻"
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "description": "経度"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "description": "緯度"
        },
        "accuracyM": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000,
          "description": "測位精度m"
        },
        "breakBefore": {
          "type": "boolean",
          "description": "Break line before this point: first in segment or deleted observations interrupt continuity. Never connect across this flag."
        }
      },
      "required": [
        "id",
        "version",
        "createdAt",
        "updatedAt",
        "personId",
        "segmentId",
        "sourcePointId",
        "observedAt",
        "longitude",
        "latitude",
        "accuracyM",
        "breakBefore"
      ],
      "additionalProperties": false,
      "description": "保存結果DTO。列の意味は ../01_DB/09_track_points.json。API別名・非公開項目はschemas/README.md。"
    },
    "GrowthItem": {
      "type": "object",
      "properties": {
        "place": {
          "$ref": "#/components/schemas/Place"
        },
        "confirmedVisitCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "purposes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/SourceRef"
          },
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "stage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "1 confirmed visit -> 1; 2-4 -> 2; 5+ -> 3. Recalculated on current data."
        }
      },
      "required": [
        "place",
        "confirmedVisitCount",
        "purposes",
        "sourceRefs",
        "stage"
      ],
      "additionalProperties": false
    }
  },
  "operations": []
}
