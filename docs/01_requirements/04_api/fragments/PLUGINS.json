  "decisions": {
    "plugin-version": "version=楽観ロック版、pluginVersion=機能版、installId=本人/モードの安定した導入ID。PLUGINS.state公開口はinstalledVersionとして同じ機能版を提供する。",
    "Q09": "本人はCORE contextからのみ解決。mode別SQLite。各機能はregisterPlugin({manifest,declarations,trial,prepare?})に固有Schema・取得元・出典・試用条件を登録する。通常地図はgetPluginState(db,context)を同期読取する。",
    "confirmation": "試用は保存しない。confirmed=trueとstateRevisionが一致した導入のみ保存。Schema検証と版ごとの準備はtransaction前、確定時に再照合。",
    "deletion": "installed=0/enabled=0として導入一覧と適用から除外。保存済み設定と履歴を保持し、記録・場所・経路・地図設定は変更しない。",
    "migration": "旧plugin_settingsをplugin_settings_legacyへ保持し本人へ無断割当しない。新plugin_settingsは(person_id,id)複合PK。旧データのowner割当は別の明示移行でのみ行う。",
    "coexist": "同じtargetKey/propertyの異なる値だけ競合。coexistは両方を独立ownerレイヤーとして表示、preferは指定した一つ。hashに機能版と宣言を含み変更時に再確認。",
    "binding": {
      "plugin-store": "getPlugins",
      "plugin-detail": "getPlugins/getPluginVersions",
      "plugin-trial": "postPluginTrial",
      "plugin-install": "postPluginSettings",
      "plugin-manage": "getPluginSettings/patchPluginSettingsPluginId",
      "plugin-update": "postPluginTrial/postPluginUpdate/postPluginRollback",
      "plugin-conflict": "trialのconflictsを表示→create/patch/update/rollbackのresolutionsで確定"
    }
  }
}
