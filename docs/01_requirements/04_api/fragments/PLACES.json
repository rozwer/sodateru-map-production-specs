              "type": "string",
              "description": "IANA timezone, null when unknown"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceUrl": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^https?://"
            },
            {
              "type": "null"
            }
          ]
        },
        "fetchedAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "verificationStatus": {
          "enum": [
            "unverified",
            "confirmed"
          ]
        }
      },
      "required": [
        "rawText",
        "timezone",
        "sourceUrl",
        "fetchedAt",
        "verificationStatus"
      ]
    },
    "PlaceEntrance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/components/schemas/Id"
        },
        "coordinates": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "label": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "accessibility": {
          "enum": [
            "unknown",
            "accessible",
            "restricted"
          ]
        },
        "sourceUrl": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^https?://"
            },
            {
              "type": "null"
            }
          ]
        },
        "fetchedAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "verificationStatus": {
          "enum": [
            "unverified",
            "confirmed"
          ]
        }
      },
      "required": [
        "id",
        "coordinates",
        "label",
        "accessibility",
        "sourceUrl",
        "fetchedAt",
        "verificationStatus"
      ]
    },
