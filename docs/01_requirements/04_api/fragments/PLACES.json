      },
      "required": [],
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Manual values override provider refresh. resetFields removes corrections and restores latest saved provider values. refreshExternal performs Nominatim lookup before the version-checked transaction. Editing authority pending user decision."
