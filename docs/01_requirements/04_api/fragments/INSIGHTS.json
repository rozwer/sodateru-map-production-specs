  "operations": [
    {
      "method": "get",
      "path": "/insights",
      "replaceOperation": true,
      "operationId": "getInsights",
      "summary": "分析・比較一覧",
      "tags": [
        "振り返り・分析・テーマ"
      ],
      "description": "権限: 本人。保存先: なし。参照先は同じ本人のデータ。読取・更新前に所有者と存在を検査する。根拠のID・version・現在の共有権限を照合し、読めない根拠を含む結果は返さない。cursorは本人・検索条件・順序に束縛し、条件不一致は400。閲覧・検索条件を適用してからページ分割。 from/toはcreatedAtへ適用。 読取/本人評価の前にSourceRefを照合。変更済みはSOURCE_CHANGED、削除/権限なしはNOT_FOUND。一覧は現在有効な結果のみ返す。",
      "parameters": [
        {
          "$ref": "#/components/parameters/query_from"
        },
        {
          "$ref": "#/components/parameters/query_to"
        },
        {
          "$ref": "#/components/parameters/query_cursor"
        },
        {
          "$ref": "#/components/parameters/query_limit"
        },
        {
          "name": "kind",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "enum": [
              "analysis",
              "comparison"
            ]
          }
        },
        {
          "$ref": "#/components/parameters/header_X-Request-Id"
        },
        {
          "name": "rangeStart",
          "in": "query",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "description": "対象期間開始の完全一致。rangeEndと組で指定。from/toはcreatedAtのまま。"
        },
        {
          "name": "rangeEnd",
          "in": "query",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "description": "対象期間終端の完全一致。rangeStartと組で指定。"
        },
        {
          "name": "timeZone",
          "in": "query",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/TimeZone"
          },
          "description": "集計timezoneの完全一致。"
        }
      ],
      "responses": {
        "200": {
          "description": "成功。本文は下記Schema。",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InsightPage"
              },
              "example": {
                "items": [],
                "nextCursor": null
              }
            }
          },
          "headers": {
            "X-Request-Id": {
              "schema": {
                "type": "string",
                "format": "uuid"
              },
              "description": "要求と同じUUID。"
            }
          }
        },
