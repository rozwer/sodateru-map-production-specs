      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/components/schemas/Id"
        },
        "version": {
          "$ref": "#/components/schemas/Version"
        },
        "createdAt": {
          "$ref": "#/components/schemas/Timestamp"
        },
        "updatedAt": {
          "$ref": "#/components/schemas/Timestamp"
        },
        "target": {
          "$ref": "#/components/schemas/CommunityBookmarkTarget"
        },
        "expiresAt": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "available",
            "expired",
            "unavailable"
          ]
        },
        "resource": {
          "anyOf": [
            {
              "type": "object",
              "description": "現在の共通読出しで解決したRecordView / Place / 元の候補。参照先の正式DTOをそのまま返す。保存スナップショットではない。"
            },
            {
              "type": "null"
            }
          ]
