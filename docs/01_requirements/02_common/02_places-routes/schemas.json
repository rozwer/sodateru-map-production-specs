              "toIndex": {
                "type": "integer",
                "minimum": 1
              },
              "geometry": {
                "$ref": "#/definitions/Geometry"
              },
              "distanceM": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "durationSec": {
                "type": "integer",
                "minimum": 0
              }
