        "mode": {
          "enum": [
            "walking",
            "cycling",
            "driving",
            "transit"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        }
      },
      "required": [
        "waypoints",
        "mode",
        "title"
