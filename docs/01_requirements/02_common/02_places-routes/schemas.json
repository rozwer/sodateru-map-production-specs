        "externalId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "buildingKey": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
