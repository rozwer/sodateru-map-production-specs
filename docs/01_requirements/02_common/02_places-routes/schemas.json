    "RouteRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "waypoints": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "stored"
                  },
                  "placeId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "kind",
                  "placeId"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "candidate"
                  },
                  "resultId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "\\S"
                  },
                  "candidateId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "kind",
                  "resultId",
                  "candidateId"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "point"
                  },
                  "coordinates": {
                    "type": "array",
                    "items": [
                      {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      },
                      {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "kind",
                  "coordinates",
                  "label"
                ]
              }
            ]
          },
          "minItems": 2,
          "maxItems": 10
