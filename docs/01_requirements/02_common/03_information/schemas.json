      "required": [
        "id",
        "person",
        "kind",
        "body",
        "place",
        "effectiveAt",
        "endedAt",
        "timePrecision",
        "visitStatus",
        "purposes",
        "impression",
        "topicKey",
        "visibility",
        "version",
        "sourceRefs",
        "media"
      ]
