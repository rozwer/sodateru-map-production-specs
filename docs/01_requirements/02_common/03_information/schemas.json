        "visitStatus": {
          "anyOf": [
            {
              "enum": [
                "candidate",
                "confirmed",
                "rejected"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "purposes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 20
        },
        "impression": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000
        },
        "topicKey": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
