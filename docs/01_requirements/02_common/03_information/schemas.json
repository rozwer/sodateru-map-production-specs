        "personIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true,
          "default": []
