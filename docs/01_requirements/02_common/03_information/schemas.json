        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceRef"
          },
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "media": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MediaView"
          },
          "minItems": 0,
          "maxItems": 100
        }
