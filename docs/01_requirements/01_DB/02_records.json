{
  "table": "records",
  "title": "記録",
  "description": ["体験の文章、日記、メモと、その文章に付けた用途・感想を保存する。"],
  "common": "common.json",
  "columns": {
    "person_id": {"type": "TEXT", "nullable": false, "description": "記録した人物"},
    "kind": {"type": "TEXT", "nullable": false, "description": "記録の種類", "enum": ["experience", "diary", "memo"]},
    "visit_id": {"type": "TEXT", "nullable": true, "description": "関連する訪問"},
    "place_id": {"type": "TEXT", "nullable": true, "description": "訪問を伴わず場所に付けた記録の関連先"},
    "occurred_at": {"type": "INTEGER", "nullable": true, "description": "体験・日記の対象日時。不明はNULL"},
    "ended_at": {"type": "INTEGER", "nullable": true, "description": "終了日時。不明はNULL"},
    "time_precision": {"type": "TEXT", "nullable": false, "description": "日時の精度", "enum": ["exact", "approximate", "unknown"]},
    "body": {"type": "TEXT", "nullable": false, "description": "入力した本文。媒体だけの記録は空文字"},
    "purposes_json": {"type": "TEXT", "nullable": false, "description": "この場所での用途", "encoding": "json"},
    "activities_json": {"type": "TEXT", "nullable": false, "description": "実際にした活動と、その活動ごとの結果", "encoding": "json"},
    "impression": {"type": "TEXT", "nullable": false, "description": "体験全体の感想"},
    "period_answers_json": {"type": "TEXT", "nullable": false, "description": "期間集計に使う任意の確認項目", "encoding": "json"},
    "bookmarked": {"type": "INTEGER", "nullable": false, "description": "しおりを付けたら1", "enum": [0, 1]},
    "use_for_suggestions": {"type": "INTEGER", "nullable": false, "description": "提案でこの記録を参照する設定", "enum": [0, 1]},
    "topic_key": {"type": "TEXT", "nullable": true, "description": "地域投稿の話題キー。通常記録はNULL"},
    "visibility": {"type": "TEXT", "nullable": false, "description": "表示する範囲", "enum": ["private", "selected", "public"]},
    "shared_with_json": {"type": "TEXT", "nullable": false, "description": "selectedで共有する人物IDの配列", "encoding": "json"}
  },
  "references": {
    "person_id": {"target": "people.id", "on_delete": "この行から参照中の対象は削除を保留し、先に関連データを処理"},
    "visit_id": {"target": "visits.id", "on_delete": "訪問の削除時にNULLへ変更し、記録本文を保持"},
    "place_id": {"target": "places.id", "on_delete": "この行から参照中の対象は削除を保留し、先に関連データを処理"}
  },
  "constraints": [
    "終了日時がある場合は開始日時も必須とし、終了≧開始にする。",
    "日時の精度がunknownの場合、開始・終了日時はNULL。",
    "訪問を参照する記録はkind=experience、visit_idを指定し、place_id・occurred_at・ended_atはNULL、time_precisionはunknownにする。場所と日時はvisitsから表示する。",
    "visit_idを指定する場合は、同じ人物の訪問を参照する。",
    "visit_idがNULLの記録は、場所と対象日時を必要に応じて直接指定する。",
    "公開範囲がselectedの場合は共有先を1人以上指定する。private/publicでは共有先配列は空にする。",
    "共有先の人物IDは存在する人物を指定し、重複を除く。"
  ],
  "indexes": [{"columns": ["person_id", "occurred_at"]}, {"columns": ["visit_id"]}, {"columns": ["visibility", "topic_key"]}, {"columns": ["place_id"]}],
  "operations": ["本文・用途・感想・しおり・公開範囲を、この記録IDに対して更新する。", "一つの訪問に複数の記録を関連付けられる。", "AIが提案した内容は、確認画面で採用した項目を保存する。", "記録を削除すると、その記録と添付媒体・テーマへの所属が消える。", "関連する訪問はvisitsに残り、訪問回数を維持する。"],
  "json_fields": {
    "purposes_json": {"fields": {"$": {"type": "array", "required": true, "uniqueItems": true}, "$[]": {"type": "string", "required": true, "minLength": 1}}},
    "activities_json": {
      "fields": {
        "$": {"type": "array", "required": true, "uniqueItems": true},
        "$[]": {"type": "object", "required": true},
        "$[].id": {"type": "string", "required": true, "minLength": 1, "maxLength": 80},
        "$[].name": {"type": "string", "required": true, "minLength": 1},
        "$[].purpose": {"type": "string", "nullable": true, "required": true},
        "$[].outcome": {"type": "string", "nullable": true, "required": true},
        "$[].satisfaction": {"type": "string", "nullable": true, "enum": ["met", "partial", "not_met"], "required": true},
        "$[].repeatIntent": {"type": "boolean", "nullable": true, "required": true}
      },
      "rules": ["活動IDは同じ記録の中で一意にする。希望が不明ならpurposeとsatisfactionをNULLにする。"]
    },
    "period_answers_json": {
      "fields": {
        "$": {"type": "object", "required": true},
        "$.detour": {"type": "boolean", "nullable": true, "required": false},
        "$.newPlace": {"type": "boolean", "nullable": true, "required": false},
        "$.rest": {"type": "boolean", "nullable": true, "required": false},
        "$.alone": {"type": "boolean", "nullable": true, "required": false},
        "$.longStay": {"type": "boolean", "nullable": true, "required": false},
        "$.farTrip": {"type": "boolean", "nullable": true, "required": false}
      }
    },
    "shared_with_json": {"$ref": "common.json#/json_definitions/id_array"}
  },
  "related_files": ["00_people.json", "15_visits.json", "01_places.json"]
}
