{
  "description": "macOS hook source. Edit this file, then run mise run hooks:install.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- node \"$(git rev-parse --show-toplevel)/scripts/codex-mise-hook.mjs\" || exit 2",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- node \"$(git rev-parse --show-toplevel)/scripts/codex-mise-hook.mjs\" || exit 2",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Bash|exec_command|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- node \"$(git rev-parse --show-toplevel)/scripts/codex-task-hook.mjs\" || exit 2",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "^(spawn_agent|Agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- node \"$(git rev-parse --show-toplevel)/scripts/codex-subagent-model-hook.mjs\" || exit 2",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
